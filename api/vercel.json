{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "maintenance-sweep": {
      "schedule": "0 * * * *",
      "timezone": "America/Sao_Paulo",
      "path": "/api/v1/internal/maintenance",
      "requestMethod": "POST"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index?__path=/health" },
    { "source": "/api/v1/:path*", "destination": "/api/index?__path=/api/v1/:path*" }
  ]
}
